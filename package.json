{
  "name": "tempoloom",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable calendar planner that schedules tasks, habits and focus time around your meetings.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev:server": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench": "node bench/scheduler-week.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@preact/signals": "^2.11.3",
    "hono": "^4.13.13",
    "ical.js": "^2.2.1",
    "nodemailer": "^10.1.7",
    "preact": "^11.0.1",
    "tsdav": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
