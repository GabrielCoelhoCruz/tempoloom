# Copy to .env and fill in. Never commit .env.
BASE_URL=http://localhost:8787
# openssl rand -base64 32 (keep it: it decrypts stored OAuth tokens)
SECRET_KEY=
# Optional: Google sign-in. Without these, users sign in with CalDAV.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: let webhooks reach receivers on a private network.
# WEBHOOK_ALLOW_PRIVATE=true
# Optional: outgoing mail (team invitations, booking and meeting emails, digests).
# Without it, admins copy invite links and no email is sent.
# SMTP_URL=smtps://user:password@mail.example.com:465
# MAIL_FROM=Tempoloom <noreply@example.com>
# Optional: the most members of a team (the operator can set it per team with the CLI).
# TEAM_SEAT_LIMIT=50
# Optional: AI tools (MCP clients at BASE_URL/mcp) may read but not stage changes.
# MCP_WRITE_ENABLED=false
# Optional: where users ask for help, shown on the help page.
# SUPPORT_URL=https://example.com/support
# Optional: seconds between full checks of mirroring copies (default twice a day).
# MIRROR_RECONCILE_SECONDS=43200
# Optional: days a one-off booking link works (default 30).
# ONEOFF_LINK_DAYS=30
